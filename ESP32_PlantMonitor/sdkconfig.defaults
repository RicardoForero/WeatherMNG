# ═══════════════════════════════════════════════════════════════════════
#  sdkconfig.defaults — ESP32 Plant Monitor
#  Estas opciones se aplican en la primera compilación.
#  Para modificar después: idf.py menuconfig
# ═══════════════════════════════════════════════════════════════════════

# ── Target ──
CONFIG_IDF_TARGET="esp32"

# ── FreeRTOS ──
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_UNICORE=n

# ── WiFi ──
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# ── LWIP ──
CONFIG_LWIP_MAX_SOCKETS=8
CONFIG_LWIP_SO_RCVBUF=y

# ── NVS ──
CONFIG_NVS_ENCRYPTION=n

# ── Log level (production: WARN; development: INFO) ──
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_MAXIMUM_LEVEL=4

# ── Watchdog ──
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_ESP_TASK_WDT_EN=y

# ── Stack overflow detection ──
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

# ── Brownout detector ──
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_0=y

# ── Partición por defecto (single factory + NVS) ──
CONFIG_PARTITION_TABLE_SINGLE_APP=y

